{
  "$schema": "https://typedoc.org/schema.json",
  "name": "API reference",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "../packages/client",
    "../packages/codegen",
    "../packages/server",
    "../packages/layers",
    "../packages/nestjs"
  ],
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "./api",
  "docsRoot": ".",
  "readme": "none",
  "hidePageHeader": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "treatWarningsAsErrors": true
}
