{
  "name": "@chanx-js/layers",
  "version": "2.1.0",
  "description": "Channel layers for Node: groups and cross-process messaging, wire-compatible with Python's channels_redis and fast-channels.",
  "license": "MIT",
  "author": "Huy Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanx-dev/chanx-js.git",
    "directory": "packages/layers"
  },
  "bugs": "https://github.com/chanx-dev/chanx-js/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@chanx-js/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./redis": {
      "@chanx-js/source": "./src/redis/index.ts",
      "types": "./dist/redis/index.d.mts",
      "default": "./dist/redis/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/redis/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "peerDependencies": {
    "redis": ">=6"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "redis": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "channel-layer",
    "redis",
    "pubsub",
    "channels",
    "websocket"
  ]
}
