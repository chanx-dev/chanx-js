{
  "name": "@chanx-js/server",
  "version": "2.1.4",
  "description": "chanx for Node: typed WebSocket consumers with topics and groups, speaking the same protocol as Python's chanx.",
  "license": "MIT",
  "author": "Huy Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanx-dev/chanx-js.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/chanx-dev/chanx-js/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@chanx-js/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@chanx-js/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./node": {
      "@chanx-js/source": "./src/adapters/node.ts",
      "types": "./dist/adapters/node.d.mts",
      "default": "./dist/adapters/node.mjs"
    },
    "./crossws": {
      "@chanx-js/source": "./src/adapters/crossws.ts",
      "types": "./dist/adapters/crossws.d.mts",
      "default": "./dist/adapters/crossws.mjs"
    },
    "./hono": {
      "@chanx-js/source": "./src/adapters/hono.ts",
      "types": "./dist/adapters/hono.d.mts",
      "default": "./dist/adapters/hono.mjs"
    },
    "./fastify": {
      "@chanx-js/source": "./src/adapters/fastify.ts",
      "types": "./dist/adapters/fastify.d.mts",
      "default": "./dist/adapters/fastify.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts src/adapters/node.ts src/adapters/crossws.ts src/adapters/hono.ts src/adapters/fastify.ts --format esm --dts.eager --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/legacy/tsconfig.json",
    "smoke:bun": "bun tests/runtimes/smoke.mjs",
    "smoke:deno": "deno run -A tests/runtimes/smoke.mjs"
  },
  "dependencies": {
    "@chanx-js/layers": "workspace:^",
    "@noble/hashes": "^2.4.0"
  },
  "peerDependencies": {
    "@fastify/websocket": ">=11",
    "crossws": ">=0.4",
    "fastify": ">=5",
    "hono": ">=4",
    "ws": ">=8.17",
    "yaml": ">=2"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    },
    "crossws": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@fastify/websocket": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chanx-js/client": "workspace:*",
    "@chanx-js/codegen": "workspace:*",
    "@chanx-js/protocol": "workspace:*",
    "@fastify/websocket": "^11.3.4",
    "@hono/node-server": "^2.1.5",
    "@msgpack/msgpack": "^3.1.3",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/ws": "^8.18.1",
    "crossws": "^0.4.16",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "h3": "^2.0.8",
    "hono": "^4.13.13",
    "koa": "^3.2.1",
    "redis": "^6.3.0",
    "srvx": "^1.0.7",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "websocket",
    "asyncapi",
    "chanx",
    "typescript"
  ]
}
