{
  "name": "@chanx-js/server",
  "version": "0.1.2",
  "private": true,
  "description": "chanx for Node: typed WebSocket consumers with topics and groups, speaking the same protocol as Python's chanx.",
  "license": "MIT",
  "author": "Huy Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huynguyengl99/chanx-js.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/huynguyengl99/chanx-js/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts src/node.ts --format esm --dts.eager --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/legacy/tsconfig.json"
  },
  "dependencies": {
    "@chanx-js/layers": "workspace:*"
  },
  "peerDependencies": {
    "ws": ">=8.17"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chanx-js/client": "workspace:*",
    "@chanx-js/protocol": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "@types/ws": "^8.18.1",
    "redis": "^6.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "websocket",
    "asyncapi",
    "chanx",
    "typescript"
  ]
}
